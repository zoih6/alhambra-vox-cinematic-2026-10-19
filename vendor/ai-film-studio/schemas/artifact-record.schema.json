{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zoih6/ai-film-studio/schemas/artifact-record.schema.json",
  "title": "AI Film Studio Artifact Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "kind", "status"],
  "properties": {
    "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"},
    "kind": {"enum": ["brief", "concept", "script", "beat-table", "storyboard", "shot-card", "prompt", "asset", "audio", "timeline", "qc-report", "delivery"]},
    "status": {"enum": ["draft", "approved", "rejected", "stale", "superseded"]},
    "path": {"type": "string"},
    "parent_ids": {"type": "array", "items": {"type": "string"}},
    "content_hash": {"type": "string"},
    "schema_version": {"type": "string"},
    "lock_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "provenance": {"$ref": "artifact-provenance.schema.json"},
    "notes": {"type": "string"}
  }
}
