{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zoih6/ai-film-studio/schemas/artifact-provenance.schema.json",
  "title": "AI Film Studio Artifact Provenance",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {"type": "string"},
    "provider": {"type": "string"},
    "model": {"type": "string"},
    "template_version": {"type": "string"},
    "seed": {"type": ["integer", "null"]},
    "input_hashes": {"type": "array", "items": {"type": "string"}},
    "parameters": {"type": "object"},
    "created_at": {"type": "string"},
    "source_urls": {"type": "array", "items": {"type": "string", "format": "uri"}}
  }
}
